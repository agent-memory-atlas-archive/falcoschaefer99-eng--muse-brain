/**
 * Copy to wrangler.jsonc and adjust values for your deployment.
 *
 * Auth secrets are NOT set here — use `wrangler secret put`:
 *   wrangler secret put API_KEY_COMPANION
 *   wrangler secret put API_KEY_RAINER
 * (Legacy: `wrangler secret put API_KEY` keeps the old header-derived-tenant behavior
 * with a deprecation warning; delete it once every tenant has its own per-tenant key.
 * See ops/MICHAEL_TENANT_KEY_AUDIT_2026-07-06.md and .env.example.)
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "muse-brain",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-27",
  "compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
  "observability": { "enabled": true },
  // Nightly metabolism (decay/novelty) needs to run SOMEWHERE, once a night, per
  // tenant. Pick ONE — running both fires the cycle twice every night:
  //   (a) box runner (recommended) — `daemon-runner/main.ts` via a systemd timer
  //       (see ops/rook-brain-daemon.service + rook-brain-daemon.timer, or your
  //       platform's cron equivalent). The Worker's own `scheduled()` handler is a
  //       no-op by design so it's safe to leave the trigger below commented out.
  //   (b) Worker cron — uncomment the line below. Only viable on Workers PAID
  //       ($5/mo+): the FREE plan caps CPU at 10ms/invocation and rejects a
  //       "limits": { "cpu_ms": ... } override (error 100328), so the daemon cycle
  //       reliably dies mid-run with error 1102 (exceededResources) on free.
  // "triggers": { "crons": ["0 3 * * *"] },
  "ai": { "binding": "AI" },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "replace-with-your-hyperdrive-id"
    }
  ]
  // Optional plain-text tenant vocabulary overrides (not secrets — safe in vars):
  // "vars": {
  //   "ALLOWED_TENANTS": "companion,rainer",
  //   "TENANT_ALIASES": "rook:companion",
  //   "CROSS_TENANT_READ_GRANTS": "rainer:companion,companion:rainer"
  // }
}
